# Пример. Скопируй в .env и вставь свои значения.
# Файл .env не коммить. Те же переменные задай в панели Netlify, не загружая сам файл.

OPENAI_API_KEY=sk-proj-your-key-here
BAZIS_AI_MODEL=gpt-4o-mini

# Пароли админки. Без них новая база не создаёт вход.
# Если база уже создана со старым паролем, первый вход заменит его на эти значения.
ADMIN_PASSWORD=choose-a-long-password
MANAGER_PASSWORD=choose-another-long-password

# Куда ведёт QR в PDF-заявке. На Netlify задайте тот же адрес.
PDF_SITE_URL=https://ai-drone-construction.netlify.app

# Адрес PDF-сервиса для кнопки в админке. Локально можно не задавать.
# VITE_PDF_BASE=http://127.0.0.1:5191

# База — файл data/site.sqlite. Отдельный адрес подключения не нужен.
